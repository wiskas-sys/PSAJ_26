# Supabase Project API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Required only for admin user invitations; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Midtrans Snap payment gateway
# Server-only. From Midtrans Dashboard > Settings > Access Keys.
MIDTRANS_SERVER_KEY=your-server-key
# Public. Safe to expose to the browser (used by snap.js).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-client-key
# Set to false to use Sandbox (app.sandbox.midtrans.com). Set to true for Production.
NEXT_PUBLIC_MIDTRANS_PRODUCTION=false

# Google Gemini AI (Rekomendasi untuk Asisten Stok)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude AI (Opsional)
# Kosongkan untuk memakai Gemini atau jawaban lokal dari data stok (tanpa LLM/berbayar).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

AI_USE_MOCK_DATA=true
AI_REQUIRE_AUTH=false
